name: "content_model"
platform: "tensorrt_plan"
max_batch_size: 0
input [
  {
    name: "input0"
    data_type: TYPE_UINT8
    dims: [8, 640, 640, 3]
  }
]
output [
  {
    name: "bboxes"
    data_type: TYPE_FP32
    dims: [8, 30, 4]
  },
  {
    name: "scores"
    data_type: TYPE_FP32
    dims: [8, 30]
  },
  {
    name: "classes"
    data_type: TYPE_INT32
    dims: [8, 30]
  }
]